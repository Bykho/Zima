<mujoco model="so101_chess">
  <include file="so101.xml"/>
  <include file="pieces.xml"/>

  <statistic center="0.25 0.0 0.12" extent="0.55"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-25"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <!-- 2x2 builtin checker × texrepeat 4 = 8×8 squares. -->
    <texture type="2d" name="board_tex" builtin="checker" rgb1="0.86 0.78 0.58" rgb2="0.42 0.26 0.12"
      width="256" height="256"/>
    <material name="board_mat" texture="board_tex" texrepeat="4 4" texuniform="false" reflectance="0.05"/>
    <material name="queen_mat" rgba="0.93 0.90 0.82 1" specular="0.4" shininess="0.3"/>
    <material name="pawn_mat" rgba="0.55 0.38 0.22 1" specular="0.2" shininess="0.2"/>
  </asset>

  <worldbody>
    <light pos="0.2 -0.2 1.2" dir="0 0.15 -1" diffuse="0.8 0.8 0.8" specular="0.3 0.3 0.3"/>
    <light pos="0.5 0.3 0.8" dir="-0.2 -0.2 -1" diffuse="0.4 0.4 0.4"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"/>

    <!-- Board: origin (a1 corner) = (0.22, -0.10), square 37.5 mm, surface z = 0.02. -->
    <body name="board" pos="0.37 0.05 0.01">
      <geom name="board" type="box" size="0.15 0.15 0.01" material="board_mat"
        friction="1.2 0.01 0.001" condim="3"/>
      <site name="board_center" pos="0 0 0.01" size="0.005"/>
    </body>

    <!-- Queen: compound geometry, origin at base contact. Spawned on d1. -->
    <body name="queen" pos="0.35125 -0.08125 0.02">
      <freejoint name="queen_free"/>
      <inertial pos="0 0 0.016" mass="0.018" diaginertia="2.2e-6 2.2e-6 1.1e-6"/>
      <!-- base -->
      <geom name="queen_base" type="cylinder" size="0.011 0.004" pos="0 0 0.004"
        material="queen_mat" friction="1.2 0.005 0.0005" condim="6" solref="0.01 1" solimp="0.95 0.99 0.001"/>
      <!-- stem — grasp here -->
      <geom name="queen_stem" type="cylinder" size="0.0045 0.010" pos="0 0 0.018"
        material="queen_mat" friction="1.4 0.005 0.0005" condim="6" solref="0.01 1" solimp="0.95 0.99 0.001"/>
      <!-- collar -->
      <geom name="queen_collar" type="cylinder" size="0.008 0.003" pos="0 0 0.031"
        material="queen_mat" friction="1.2 0.005 0.0005" condim="6"/>
      <!-- crown cup -->
      <geom name="queen_crown" type="cylinder" size="0.007 0.006" pos="0 0 0.040"
        material="queen_mat" friction="1.2 0.005 0.0005" condim="6"/>
      <!-- coronet points -->
      <geom name="queen_pt0" type="sphere" size="0.0026" pos="0.006 0 0.0485" material="queen_mat"/>
      <geom name="queen_pt1" type="sphere" size="0.0026" pos="0.00185 0.0057 0.0485" material="queen_mat"/>
      <geom name="queen_pt2" type="sphere" size="0.0026" pos="-0.00485 0.0035 0.0485" material="queen_mat"/>
      <geom name="queen_pt3" type="sphere" size="0.0026" pos="-0.00485 -0.0035 0.0485" material="queen_mat"/>
      <geom name="queen_pt4" type="sphere" size="0.0026" pos="0.00185 -0.0057 0.0485" material="queen_mat"/>
      <geom name="queen_ball" type="sphere" size="0.0032" pos="0 0 0.052" material="queen_mat"/>
      <site name="queen_grasp" pos="0 0 0.016" size="0.003" rgba="0.1 0.8 0.2 0.5"/>
    </body>

    <!-- Pawn proxy: parked under the board unless a scenario places it. -->
    <body name="pawn" pos="0.37 0.05 -0.5">
      <freejoint name="pawn_free"/>
      <inertial pos="0 0 0.012" mass="0.008" diaginertia="8e-7 8e-7 4e-7"/>
      <geom name="pawn_base" type="cylinder" size="0.009 0.0035" pos="0 0 0.0035"
        material="pawn_mat" friction="1.2 0.005 0.0005" condim="6" solref="0.01 1" solimp="0.95 0.99 0.001"/>
      <geom name="pawn_stem" type="cylinder" size="0.0055 0.009" pos="0 0 0.016"
        material="pawn_mat" friction="1.2 0.005 0.0005" condim="6"/>
      <geom name="pawn_head" type="sphere" size="0.0075" pos="0 0 0.030" material="pawn_mat"/>
    </body>


