<mujoco model="so101_chess">
  <include file="so101.xml"/>
  <include file="chessmen.xml"/>

  <statistic center="0.25 0.0 0.12" extent="0.55"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-25"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <!-- 2x2 builtin checker × texrepeat 4 = 8×8 squares. -->
    <texture type="2d" name="board_tex" builtin="checker" rgb1="0.86 0.78 0.58" rgb2="0.42 0.26 0.12"
      width="256" height="256"/>
    <material name="board_mat" texture="board_tex" texrepeat="4 4" texuniform="false" reflectance="0.05"/>
  </asset>

  <worldbody>
    <light pos="0.2 -0.2 1.2" dir="0 0.15 -1" diffuse="0.8 0.8 0.8" specular="0.3 0.3 0.3"/>
    <light pos="0.5 0.3 0.8" dir="-0.2 -0.2 -1" diffuse="0.4 0.4 0.4"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"/>

    <!-- Board: origin (a1 corner) from config; size applied in Sim.apply_board_layout. -->
    <body name="board" pos="0.35 0.03 0.01">
      <geom name="board" type="box" size="0.19 0.19 0.01" material="board_mat"
        friction="1.2 0.01 0.001" condim="3"/>
      <site name="board_center" pos="0 0 0.01" size="0.005"/>
    </body>

    <!-- Capture tray in front of white. Captured pieces stay as themselves. -->
    <body name="capture_bowl" pos="0.35 -0.26 0.01">
      <geom name="bowl_floor" type="box" size="0.05 0.05 0.005" pos="0 0 0.005"
        rgba="0.32 0.20 0.12 1" friction="1.5 0.01 0.001" condim="3"/>
      <geom name="bowl_n" type="box" size="0.05 0.006 0.016" pos="0 0.044 0.016"
        rgba="0.36 0.22 0.13 1"/>
      <geom name="bowl_s" type="box" size="0.05 0.006 0.016" pos="0 -0.044 0.016"
        rgba="0.36 0.22 0.13 1"/>
      <geom name="bowl_e" type="box" size="0.006 0.044 0.016" pos="0.044 0 0.016"
        rgba="0.36 0.22 0.13 1"/>
      <geom name="bowl_w" type="box" size="0.006 0.044 0.016" pos="-0.044 0 0.016"
        rgba="0.36 0.22 0.13 1"/>
    </body>

    <!-- Off-board well: insert a fallen piece while holding; walls stand it up. -->
    <body name="reorient_nest" pos="0.22 -0.26 0.01">
      <geom name="nest_floor" type="box" size="0.020 0.020 0.004" pos="0 0 0.004"
        rgba="0.28 0.16 0.10 1" friction="1.4 0.01 0.001" condim="3"/>
      <geom name="nest_n" type="box" size="0.022 0.005 0.008" pos="0 0.019 0.016"
        rgba="0.42 0.26 0.14 1" friction="0.55 0.005 0.0005"/>
      <geom name="nest_s" type="box" size="0.022 0.005 0.008" pos="0 -0.019 0.016"
        rgba="0.42 0.26 0.14 1" friction="0.55 0.005 0.0005"/>
      <geom name="nest_e" type="box" size="0.005 0.014 0.008" pos="0.019 0 0.016"
        rgba="0.42 0.26 0.14 1" friction="0.55 0.005 0.0005"/>
      <geom name="nest_w" type="box" size="0.005 0.014 0.008" pos="-0.019 0 0.016"
        rgba="0.42 0.26 0.14 1" friction="0.55 0.005 0.0005"/>
      <geom name="nest_flare_n" type="box" size="0.036 0.006 0.007" pos="0 0.034 0.031"
        rgba="0.38 0.24 0.13 1" friction="0.45 0.005 0.0005"/>
      <geom name="nest_flare_s" type="box" size="0.036 0.006 0.007" pos="0 -0.034 0.031"
        rgba="0.38 0.24 0.13 1" friction="0.45 0.005 0.0005"/>
      <geom name="nest_flare_e" type="box" size="0.006 0.028 0.007" pos="0.034 0 0.031"
        rgba="0.38 0.24 0.13 1" friction="0.45 0.005 0.0005"/>
      <geom name="nest_flare_w" type="box" size="0.006 0.028 0.007" pos="-0.034 0 0.031"
        rgba="0.38 0.24 0.13 1" friction="0.45 0.005 0.0005"/>
    </body>

    <!-- Developer cameras — not used by the robot. -->
    <camera name="debug_overview" pos="0.62 -0.48 0.38" xyaxes="0.78 0.62 0  -0.28 0.35 0.90"/>
    <camera name="debug_side" pos="0.37 -0.52 0.18" xyaxes="1 0 0  0 0.35 0.94"/>
    <camera name="debug_top" pos="0.37 0.05 0.55" xyaxes="0 -1 0  1 0 0"/>
  </worldbody>
</mujoco>
